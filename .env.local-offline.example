# Copy to .env.local-offline on the laptop that will act as the local
# server. Not committed to git — docker-compose.local.yml reads it via
# env_file. See docs/OFFLINE.md for the full one-time setup.

# Must match the postgres service's fixed credentials in
# docker-compose.local.yml exactly — this stack is only ever reachable on
# the venue's closed LAN, so a static local password is fine here.
DATABASE_URL=postgresql://pokerclub:pokerclub@postgres:5432/pokerclub

# Leave empty — nothing in this mode needs it (the Telegram-login route
# simply won't be used; players are added as walk-ins instead).
BOT_TOKEN=

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Must stay 3001 — web-td's nginx.conf proxies to api:3001.
API_PORT=3001

# web-td is published on a fixed port 8080 (see docker-compose.local.yml —
# not configurable here, since compose-file port mappings don't read
# env_file values). Find the laptop's LAN IP with `ipconfig` and open
# http://<that-ip>:8080 from any other device on the same Wi-Fi.
