# Postgres (Neon) — populated into .env.local by `neon env pull` / `neon deploy`
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Telegram bot (from @BotFather)
BOT_TOKEN=

# Shared secret for signing player session JWTs after Telegram initData validation
JWT_SECRET=

# API
API_PORT=3001
API_BASE_URL=http://localhost:3001

# Public HTTPS tunnel URL for the player Mini App during local dev (ngrok/cloudflared)
WEB_PLAYER_PUBLIC_URL=

# Public HTTPS tunnel URL for the TD panel during local dev
WEB_TD_PUBLIC_URL=

# Production only — set this to switch the bot from long polling to webhook
# mode (Telegram POSTs updates to this public HTTPS URL instead). Leave unset
# for local dev. BOT_WEBHOOK_PORT is the local port the bot's tiny HTTP
# server listens on; a reverse proxy should forward BOT_WEBHOOK_URL to it.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_PORT=3002
