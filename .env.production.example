# Copy to .env.production on the server and fill in real values.
# Not committed to git — docker-compose.production.yml reads it via env_file.

# Reuse the same Neon connection string already used in dev (packages/shared
# only needs the pooled URL at runtime — DATABASE_URL_UNPOOLED is for
# drizzle-kit migrations, not needed by the running containers).
DATABASE_URL=

BOT_TOKEN=
JWT_SECRET=

# Bot's @username (no @) — renders the Telegram Login Widget so web-td can be
# opened in a plain browser, not just inside Telegram (not read by any
# container at runtime, only baked in at build time, see below).
# You must ALSO register WEB_TD_PUBLIC_URL's host as the bot's domain via
# @BotFather's /setdomain, or the widget will refuse to render.
#
# IMPORTANT: docker-compose only substitutes build `args:` from a literal
# `.env` file (or the shell environment) — NOT from this .env.production file
# via env_file:, since that's a runtime-only mechanism. Put this same line in
# /opt/poker-club/.env (create it if missing) as well, or the login widget
# will silently build with no bot username.
BOT_USERNAME=

# Must stay 3001 — nginx.conf (web-player/web-td) proxies to api:3001.
API_PORT=3001

# The three public sslip.io addresses (see DEPLOY.md). <ip> is the server's
# public IP with dots replaced by dashes, e.g. 213-148-9-40.
WEB_PLAYER_PUBLIC_URL=https://poker-app.<ip>.sslip.io
WEB_TD_PUBLIC_URL=https://poker-td.<ip>.sslip.io
BOT_WEBHOOK_URL=https://poker-bot.<ip>.sslip.io
BOT_WEBHOOK_PORT=3002
# Generate with: openssl rand -hex 32
BOT_WEBHOOK_SECRET=
