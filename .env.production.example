# Copy to .env.production on the server and fill in real values.
# Not committed to git — docker-compose.production.yml reads it via env_file.

# Self-hosted Postgres (the `postgres` service in docker-compose.production.yml)
# — no third-party DB, no quota. POSTGRES_* are read directly by the official
# postgres image's own entrypoint; DATABASE_URL/DATABASE_URL_UNPOOLED must use
# the same values (host "postgres" = the compose service name, reachable only
# from the other containers on this project's network). Generate the password
# with: openssl rand -hex 24
POSTGRES_DB=pokerclub
POSTGRES_USER=pokerclub
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://pokerclub:<same-password-as-above>@postgres:5432/pokerclub
# Only drizzle-kit (migrations) reads this — no pooler in front of a
# self-hosted Postgres, so it's identical to DATABASE_URL above.
DATABASE_URL_UNPOOLED=postgresql://pokerclub:<same-password-as-above>@postgres:5432/pokerclub

BOT_TOKEN=
JWT_SECRET=

# Must stay 3001 — nginx.conf (web-player/web-td) proxies to api:3001.
API_PORT=3001

# The three public sslip.io addresses (see DEPLOY.md). <ip> is the server's
# public IP with dots replaced by dashes, e.g. 213-148-9-40.
WEB_PLAYER_PUBLIC_URL=https://poker-app.<ip>.sslip.io
WEB_TD_PUBLIC_URL=https://poker-td.<ip>.sslip.io
BOT_WEBHOOK_URL=https://poker-bot.<ip>.sslip.io
BOT_WEBHOOK_PORT=3002
# Generate with: openssl rand -hex 32
BOT_WEBHOOK_SECRET=
