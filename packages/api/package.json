{
  "name": "@poker/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:seed": "tsx src/seed.ts",
    "local:init-club": "tsx src/scripts/initLocalClub.ts",
