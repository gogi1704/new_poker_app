  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@poker/shared": "workspace:*",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.38.3",
    "fastify": "5.2.0",
    "fastify-plugin": "5.0.1",
    "jsonwebtoken": "9.0.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
